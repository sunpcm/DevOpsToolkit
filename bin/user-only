#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "--capabilities-json" ]]; then
  [[ $# -eq 1 ]] || { echo "错误：--capabilities-json 不接受其他参数。" >&2; exit 2; }
  exec "${ROOT_DIR}/bin/devops-toolkit" --capabilities-json --entrypoint user-only
fi
INVENTORY="${1:-}"

if [[ -z "${INVENTORY}" ]]; then
  echo "用法：$0 <inventory> [ansible-playbook 参数]"
  echo "密码登录追加 --ask-pass；密钥登录追加 --private-key <path>。"
  exit 1
fi

COLLECTIONS_DIR="${ROOT_DIR}/collections"
if [[ -d "${COLLECTIONS_DIR}/ansible_collections" ]]; then
  export ANSIBLE_COLLECTIONS_PATH="${COLLECTIONS_DIR}"
  export ANSIBLE_COLLECTIONS_PATHS="${COLLECTIONS_DIR}"
fi
export ANSIBLE_CONFIG="${ROOT_DIR}/ansible/ansible.cfg"
exec "${ROOT_DIR}/bin/ansible-playbook" -i "${INVENTORY}" \
  "${ROOT_DIR}/ansible/playbooks/user-only.yml" "${@:2}"
